# =============================================================================
# Service environment template (Person 1)
# Copy to .env and adjust. Never commit .env — only this example file.
# =============================================================================

# --- Server (required) ---
# TCP port the HTTP server listens on
PORT=8080

# development | test | production
NODE_ENV=development

# Public base URL of this service (no trailing slash). Used for docs / Location.
BASE_URL=http://localhost:8080

# --- Database (required) ---
# SQLite file path. Relative paths are resolved from the service/ directory.
# Local default:
DATABASE_PATH=./db/reservation.sqlite
# On Vercel set this to: /tmp/reservation.sqlite

# OIDC / Authorization Server
OIDC_ISSUER=http://localhost:8080/realms/study-reservation
OIDC_JWKS_URI=http://localhost:8080/realms/study-reservation/protocol/openid-connect/certs
OIDC_AUDIENCE=study-reservation-api

# Local development only
DEV_AUTH_SECRET=local-dev-placeholder-secret-change-in-production