# =============================================================================
# Service environment template (Person 1)
# Copy to .env and adjust. Never commit .env — only this example file.
# =============================================================================

# --- Server (required) ---
# TCP port the HTTP server listens on
# When Keycloak uses host port 8080 (see infra/), set this to e.g. 3000.
PORT=8080

# development | test | production
NODE_ENV=development

# Public base URL of this service (no trailing slash). Used for docs / Location.
BASE_URL=http://localhost:8080

# --- Database (required) ---
# SQLite file path. Relative paths are resolved from the service/ directory.
# Local default:
DATABASE_PATH=./db/reservation.sqlite
# On Vercel set this to: /tmp/reservation.sqlite

# --- OIDC / authorisation server (Session 4) ---
# Values come from Keycloak discovery; do not commit real secrets.
# Discovery: GET $OIDC_ISSUER/.well-known/openid-configuration
OIDC_ISSUER=
OIDC_JWKS_URI=
OIDC_AUDIENCE=
