# =============================================================================
# Service environment template (Person 1)
# Copy to .env and adjust. Never commit .env — only this example file.
# =============================================================================

# --- Server (required) ---
# TCP port the HTTP server listens on
PORT=8080

# development | test | production
NODE_ENV=development

# Public base URL of this service (no trailing slash). Used for docs / Location.
BASE_URL=http://localhost:8080

# --- Database (required) ---
# SQLite file path. Relative paths are resolved from the service/ directory.
# Local default:
DATABASE_PATH=./db/reservation.sqlite
# On Vercel (documented): /tmp/reservation.sqlite
# Note: api/index.js forces :memory: on Vercel regardless of this value.

# --- OIDC / Authorization Server (required at boot) ---
# Local Keycloak (docker compose in infra/). On Vercel Production set the same
# three names; localhost values are boot placeholders (iss/aud string checks).
# JWKS is only fetched when an RS256 token is presented — not at boot.
OIDC_ISSUER=http://localhost:8080/realms/study-reservation
OIDC_JWKS_URI=http://localhost:8080/realms/study-reservation/protocol/openid-connect/certs
OIDC_AUDIENCE=study-reservation-api

# HS256 lab / demo tokens (verify.js). Optional for unauthenticated 401 smoke.
# If minting tokens against Production, use the same secret on Vercel.
DEV_AUTH_SECRET=local-dev-placeholder-secret-change-in-production

# --- Vercel Production checklist (set in Vercel UI, not this file) ---
# NODE_ENV=production
# PORT=3000
# DATABASE_PATH=/tmp/reservation.sqlite
# BASE_URL=https://study-reservation-pbse-feature-data.vercel.app
# OIDC_ISSUER / OIDC_JWKS_URI / OIDC_AUDIENCE (required; see values above)
# DEV_AUTH_SECRET (optional; match local if using HS256 lab tokens)
# Production branch = main; turn OFF Vercel Authentication for Production only
