{
  "name": "study-reservation-service",
  "version": "0.1.0",
  "description": "Backend service for Study Room Reservation System (PBSE Week 3)",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "db:init": "node db/init.js",
    "test": "jest",
    "test:contract": "jest tests/contract"
  },
  "keywords": [
    "pbse",
    "contract-first",
    "express",
    "study-reservation"
  ],
  "author": "PBSE Team",
  "license": "ISC",
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.2"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2"
  },
  "jest": {
    "testEnvironment": "node",
    "rootDir": "..",
    "moduleDirectories": [
      "node_modules",
      "<rootDir>/service/node_modules"
    ],
    "setupFiles": [
      "<rootDir>/tests/setup.js"
    ],
    "testMatch": [
      "<rootDir>/tests/**/*.test.js"
    ],
    "passWithNoTests": true
  }
}
