{
  "version": 2,
  "installCommand": "npm install",
  "functions": {
    "api/index.js": {
      "memory": 1024,
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/health", "destination": "/api" },
    { "source": "/v1/health", "destination": "/api" },
    { "source": "/v1/:path*", "destination": "/api" },
    { "source": "/docs", "destination": "/api" },
    { "source": "/docs/:path*", "destination": "/api" },
    { "source": "/openapi.json", "destination": "/api" },
    { "source": "/openapi.yaml", "destination": "/api" }
  ]
}
