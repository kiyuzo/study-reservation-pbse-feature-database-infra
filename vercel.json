{
  "version": 2,
  "installCommand": "npm install",
  "buildCommand": "node -e \"console.log('vercel build ok; runtime=node20 sql.js')\"",
  "functions": {
    "api/index.js": {
      "includeFiles": "{service/db/**,service/src/**,openapi.yaml,openapi.json,node_modules/sql.js/dist/**}",
      "memory": 1024,
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api" }
  ]
}
