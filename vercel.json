{
  "version": 2,
  "installCommand": "npm install",
  "buildCommand": "npm rebuild better-sqlite3",
  "functions": {
    "api/index.js": {
      "includeFiles": "service/db/**",
      "memory": 1024,
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api" }
  ]
}
