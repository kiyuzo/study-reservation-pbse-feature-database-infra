{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/index.js": {
      "includeFiles": "{api/_vendor/**,api/schema.sql,api/seed.sql}",
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/health", "destination": "/api" },
    { "source": "/v1/(.*)", "destination": "/api" },
    { "source": "/docs", "destination": "/api" },
    { "source": "/docs/(.*)", "destination": "/api" },
    { "source": "/openapi.json", "destination": "/api" },
    { "source": "/openapi.yaml", "destination": "/api" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
